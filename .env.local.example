# Whole Dad Movement — local env
# Copy this file to .env.local and fill in real values, or set these in Vercel.

# Supabase server-side (used by the /api/apply route)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: site URL for canonical/OG (used by Next metadata)
NEXT_PUBLIC_SITE_URL=https://coaching.wholedadmovement.com

# Email notifications (Resend) — sends a notification email whenever
# someone submits the application form. If RESEND_API_KEY is unset the
# form still works; the email is just skipped (logged as a warning).
RESEND_API_KEY=re_your_resend_key
NOTIFY_EMAIL=josh@wholedadmovement.com
# Until you verify a domain in Resend, leave this as onboarding@resend.dev.
# After verifying wholedadmovement.com, switch to e.g.:
#   applications@wholedadmovement.com
RESEND_FROM=Whole Dad Movement <onboarding@resend.dev>
